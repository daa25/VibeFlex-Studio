# --- Database (Supabase Postgres) ---
DATABASE_URL="postgresql://postgres:password@localhost:5432/vibeflex_pod_studio"

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# --- Auth (internal MVP: restrict to approved admins) ---
ADMIN_ALLOWED_EMAILS="you@example.com"

# --- Shopify Admin API (used by the Product Studio to publish/update products) ---
SHOPIFY_SHOP_DOMAIN="vibeflex-813.myshopify.com"
SHOPIFY_ADMIN_API_ACCESS_TOKEN="shpat_xxxxxxxxxxxxxxxxxxxx"
SHOPIFY_API_VERSION="2025-01"

# --- Shopify Storefront API (used by the headless storefront to READ products) ---
# Create this in Shopify Admin: Settings > Apps > Develop apps > (your app) >
# API credentials > Storefront API > install, then copy the public token.
SHOPIFY_STOREFRONT_ACCESS_TOKEN="your-storefront-access-token"
SHOPIFY_STOREFRONT_API_VERSION="2025-01"

# --- POD Provider: Printful (first integration) ---
PRINTFUL_API_KEY="your-printful-api-key"
PRINTFUL_STORE_ID="your-printful-store-id"

# --- AI Provider ---
OPENAI_API_KEY="sk-xxxxxxxxxxxxxxxxxxxx"

# --- Jobs (Inngest) ---
INNGEST_EVENT_KEY="your-inngest-event-key"
INNGEST_SIGNING_KEY="your-inngest-signing-key"

# --- Monitoring ---
SENTRY_DSN=""
