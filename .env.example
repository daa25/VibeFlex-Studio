# Copy to .env.local and fill in. NEVER commit a filled-in file.
# Only NEXT_PUBLIC_* variables are exposed to the browser; everything else is
# server-only and must never be imported into a client component.

# --- Database (Supabase Postgres or any Postgres) ---
DATABASE_URL=

# --- Supabase (artwork storage) ---
NEXT_PUBLIC_SUPABASE_URL=https://ezxnktrxkaffkalxwskv.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=vibeflex-artwork

# --- Studio admin gate (protects /dashboard and Shopify draft publishing) ---
STUDIO_ADMIN_USER=
STUDIO_ADMIN_PASSWORD=
ADMIN_ALLOWED_EMAILS=

# --- Shopify Admin API (publishing draft products, reading orders) ---
SHOPIFY_SHOP_DOMAIN=vibeflex-813.myshopify.com
# Admin API auth — use EITHER a direct access token ...
SHOPIFY_ADMIN_API_ACCESS_TOKEN=
# ... OR OAuth client credentials (Shopify-managed installation). The server
# exchanges these for a short-lived admin token; never expose them to the client.
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_API_VERSION=2026-10

# --- Shopify Storefront API (headless storefront + cart/checkout) ---
SHOPIFY_STOREFRONT_ACCESS_TOKEN=
SHOPIFY_STOREFRONT_API_VERSION=2026-10

# --- Shopify webhooks (orders/create -> fulfillment) ---
SHOPIFY_WEBHOOK_SECRET=

# --- POD provider ---
POD_PROVIDER=printify
PRINTFUL_API_KEY=
PRINTFUL_STORE_ID=
PRINTIFY_API_KEY=
PRINTIFY_SHOP_ID=
GELATO_API_KEY=
FULFILLMENT_AUTO_SUBMIT=

# --- AI artwork analysis ---
OPENAI_API_KEY=
OPENAI_VISION_MODEL=

# --- Deployment ---
NEXT_PUBLIC_BASE_URL=
SENTRY_DSN=
